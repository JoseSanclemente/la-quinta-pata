---
import { Image } from "astro:assets";
import Button from "@/components/Button";
import logo from "@/assets/logo.webp";

const BLUE_ROUTES = [
  "/quienes-somos",
  "/politicas-de-privacidad",
  "/terminos-y-condiciones",
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const onBlue = BLUE_ROUTES.includes(path);
const isQuienesSomos = path === "/quienes-somos";
---

<header
  id="site-header"
  data-keep-nav={isQuienesSomos ? "" : undefined}
  class="page-grid fixed inset-x-0 top-0 z-20 items-center gap-y-3 py-5"
>
  <a
    href="/"
    aria-label="La Quinta Pata, inicio"
    class="logo-link col-start-1 col-end-5 rounded-md transition-opacity hover:opacity-80 md:col-start-1 lg:col-end-5"
  >
    <Image
      src={logo}
      alt="La Quinta Pata — Archivo digital"
      widths={[256, 512]}
      sizes="(min-width: 768px) 228px, 80px"
      class="logo-mark mx-auto h-24 w-auto scale-100 brightness-0 invert transition-transform duration-200 select-none hover:scale-105 md:mx-0 md:h-24"
    />
  </a>

  <nav
    aria-label="Principal"
    class="col-start-1 col-end-5 [display:none] items-center justify-between gap-x-4 gap-y-2 transition-opacity duration-300 md:col-start-6 md:col-end-9 md:[display:flex] md:justify-end md:gap-x-8 lg:col-start-9 lg:col-end-13"
  >
    {
      !isQuienesSomos && (
        <Button href="/quienes-somos" variant="link">
          ¿Quiénes Somos?
        </Button>
      )
    }
    <Button href="/memorias" variant={onBlue ? "secondary" : "primary"}>
      Dejá tu recuerdo
    </Button>
  </nav>
</header>

<script>
  const hero = document.getElementById("hero");
  const footer = document.getElementById("site-footer");
  const header = document.getElementById("site-header");
  if (hero && header) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle("in-hero", entry.isIntersecting),
      { threshold: 0.5 },
    ).observe(hero);
  }
  if (footer && header && !header.hasAttribute("data-keep-nav")) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle("at-bottom", entry.isIntersecting),
      { threshold: 0 },
    ).observe(footer);
  }
</script>
