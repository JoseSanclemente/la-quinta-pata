---
import { Image } from "astro:assets";
import logo from "@/assets/logo.webp";
---

<header class="page-grid items-center gap-y-3 py-5">
  <a
    href="/"
    aria-label="La Quinta Pata, inicio"
    class="col-start-1 col-end-5 rounded-md transition-opacity hover:opacity-80 md:col-start-1 lg:col-end-5"
  >
    <Image
      src={logo}
      alt="La Quinta Pata — Archivo digital"
      widths={[256, 512]}
      sizes="(min-width: 768px) 228px, 128px"
      class="mx-auto h-32 w-auto md:mx-0 md:h-24"
    />
  </a>

  <nav
    aria-label="Principal"
    class="col-start-1 col-end-5 [display:none] items-center justify-between gap-x-4 gap-y-2 md:col-start-6 md:col-end-9 md:[display:flex] md:justify-end md:gap-x-8 lg:col-start-9 lg:col-end-13"
  >
    <a
      href="/quienes-somos"
      class="text-blue inline-flex min-h-11 items-center rounded-md px-1 text-sm whitespace-nowrap hover:underline md:text-base"
    >
      ¿Quiénes Somos?
    </a>
    <a
      href="/memorias"
      class="bg-blue inline-flex min-h-11 items-center rounded-md px-5 py-3 text-sm font-semibold whitespace-nowrap text-white transition-opacity hover:opacity-90 md:text-base"
    >
      Dejá tu recuerdo
    </a>
  </nav>
</header>
