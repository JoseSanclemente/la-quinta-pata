---
import { Image } from "astro:assets";
import Button from "@/components/Button";
import logo from "@/assets/logo.webp";

const BLUE_ROUTES = [
  "/quienes-somos",
  "/politicas-de-privacidad",
  "/terminos-y-condiciones",
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const onBlue = BLUE_ROUTES.includes(path);
const isQuienesSomos = path === "/quienes-somos";
const hasHero = path === "/";
---

<header
  id="site-header"
  data-keep-nav={isQuienesSomos ? "" : undefined}
  data-hero={hasHero ? "" : undefined}
  class="page-grid fixed inset-x-0 z-20"
>
  <a
    href="/"
    aria-label="La Quinta Pata, inicio"
    class="logo-link col-span-6 rounded-md transition-opacity md:col-span-4"
  >
    <Image
      src={logo}
      alt="La Quinta Pata — Archivo digital"
      widths={[256, 512]}
      sizes="(min-width: 768px) 228px, 80px"
      class="logo-mark mx-auto h-24 w-auto scale-100 brightness-0 invert transition-transform duration-200 select-none hover:scale-105 md:mx-0 md:h-24"
    />
  </a>

  <nav
    aria-label="Principal"
    class="header-drop col-span-4 [display:none] items-center justify-end gap-x-6 transition-opacity duration-300 md:[display:flex] lg:col-end-13"
  >
    {
      !isQuienesSomos && (
        <Button href="/quienes-somos" variant="link">
          ¿Quiénes Somos?
        </Button>
      )
    }
    <Button href="/memorias" variant={onBlue ? "secondary" : "primary"}>
      Deja tu recuerdo
    </Button>
  </nav>
</header>

<script>
  const hero = document.getElementById("hero");
  const footer = document.getElementById("site-footer");
  const header = document.getElementById("site-header");
  if (hero && header) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle("past-hero", !entry.isIntersecting),
      { threshold: 0.5 },
    ).observe(hero);
  }
</script>
