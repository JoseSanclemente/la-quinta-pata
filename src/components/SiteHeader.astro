---
import { Image } from "astro:assets";
import logo from "@/assets/logo.webp";
---

<header class="page-grid items-center py-5">
  <a href="/" class="col-start-1 col-end-3 md:col-end-4 lg:col-end-5">
    <Image
      src={logo}
      alt="La Quinta Pata — Archivo digital"
      widths={[256, 512]}
      sizes="(min-width: 768px) 228px, 128px"
      class="h-18 w-auto md:h-32"
    />
  </a>

  <nav
    class="col-start-3 col-end-5 flex items-center justify-end gap-4 md:col-start-6 md:col-end-9 md:gap-8 lg:col-start-9 lg:col-end-13"
  >
    <a
      href="/quienes-somos"
      class="text-sm text-blue hover:underline md:text-base"
    >
      ¿Quiénes Somos?
    </a>
    <a
      href="/memorias"
      class="rounded-md bg-blue px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90 md:text-base"
    >
      Conocer anécdotas
    </a>
  </nav>
</header>
