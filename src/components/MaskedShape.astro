---
import { getImage } from "astro:assets";

interface Props {
  image: ImageMetadata;
  size?: "contain" | "100% 100%";
  width?: number;
  class?: string;
}

const { image, size = "contain", width = 1200, class: className } = Astro.props;

const mask = await getImage({
  src: image,
  width: Math.min(width, image.width),
  format: "webp",
});
---

<div
  aria-hidden="true"
  class:list={["pointer-events-none", className]}
  style={`aspect-ratio: ${image.width} / ${image.height};
          -webkit-mask: url(${mask.src}) center / ${size} no-repeat;
          mask: url(${mask.src}) center / ${size} no-repeat;`}
>
</div>
