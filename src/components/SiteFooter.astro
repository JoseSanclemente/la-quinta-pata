---
const year = new Date().getFullYear();

const links = [
  { label: "Quiénes somos", href: "/quienes-somos" },
  { label: "Políticas de privacidad", href: "/politicas-de-privacidad" },
  { label: "Términos y Condiciones", href: "/terminos-y-condiciones" },
];
---

<footer
  id="site-footer"
  class="page-grid w-full items-center gap-y-3 border-t border-white bg-blue py-4 text-xs text-neutral"
>
  <div
    class="col-start-1 col-end-5 flex items-center gap-3 md:col-end-5 lg:col-end-6"
  >
    <span>{year} © La Quinta Pata</span>
    <a
      href="https://instagram.com"
      target="_blank"
      rel="noreferrer"
      aria-label="Instagram de La Quinta Pata"
      class="on-dark inline-flex min-h-11 min-w-11 items-center justify-center rounded-md transition-opacity hover:opacity-70"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
        class="h-4 w-4"
      >
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"></circle>
      </svg>
    </a>
  </div>

  <nav
    aria-label="Legal"
    class="col-start-1 col-end-5 flex flex-wrap items-center gap-x-5 gap-y-1 md:col-start-5 md:col-end-9 md:justify-self-end lg:col-start-6 lg:col-end-13 lg:justify-self-end"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="on-dark inline-flex min-h-11 items-center rounded-md hover:underline"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</footer>
