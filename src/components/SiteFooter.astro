---
const year = new Date().getFullYear();

const links = [
  { label: "Quiénes somos", href: "/quienes-somos" },
  { label: "Políticas de privacidad", href: "/politicas-de-privacidad" },
  { label: "Términos y Condiciones", href: "/terminos-y-condiciones" },
];
---

<footer
  id="site-footer"
  class="bg-blue text-neutral w-full border-t border-white py-4 text-sm md:text-base"
>
  <div class="page-gutter flex items-end justify-between gap-3 md:items-center">
    <div
      class="flex flex-col items-start gap-2 md:flex-row md:items-center md:gap-6"
    >
      <a
        href="https://www.instagram.com/laquintapata.arch/"
        target="_blank"
        rel="noreferrer"
        aria-label="Instagram de La Quinta Pata"
        class="on-dark inline-flex items-center justify-center rounded-md transition-opacity hover:opacity-70"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
          class="h-6 w-6"
        >
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"></circle>
        </svg>
      </a>
      <span class="leading-0">{year} © La Quinta Pata</span>
    </div>

    <div class="flex items-center justify-center md:items-center">
      <nav
        aria-label="Legal"
        class="flex flex-col items-end justify-center gap-2 md:flex-row md:flex-wrap md:items-center md:gap-x-5 md:gap-y-1"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              class="on-dark inline-flex items-center rounded-md hover:underline"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
