---
import { Image } from "astro:assets";
import tape1 from "../assets/tape_1.webp";
import tape2 from "../assets/tape_2.webp";

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Widths the photo renders at, for the srcset. */
  sizes?: string;
  class?: string;
}

const {
  image,
  alt,
  sizes = "(min-width: 768px) min(760px, 60vw), 100vw",
  class: className,
} = Astro.props;
---

<!-- The strips overhang the corners, so they're positioned against this wrapper
     rather than the image itself. -->
<div class:list={["relative", className]}>
  <Image
    src={image}
    alt={alt}
    widths={[500, image.width]}
    sizes={sizes}
    class="w-full rounded-sm shadow-[0_4px_24px_rgba(0,0,0,0.25)]"
  />
  <Image
    src={tape1}
    alt=""
    aria-hidden="true"
    class="absolute -top-7 -left-6 h-24 w-auto -rotate-45 md:-top-10 md:-left-10 md:h-40"
  />
  <Image
    src={tape2}
    alt=""
    aria-hidden="true"
    class="absolute -top-8 -right-6 h-28 w-auto rotate-45 md:-top-12 md:-right-10 md:h-44"
  />
</div>
