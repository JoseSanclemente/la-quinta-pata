---
import { Image } from "astro:assets";
import tape1 from "@/assets/tape_1.webp";
import tape2 from "@/assets/tape_2.webp";

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes?: string;
  class?: string;
}

const {
  image,
  alt,
  sizes = "(min-width: 768px) min(760px, 60vw), 100vw",
  class: className,
} = Astro.props;
---

<div class:list={["relative", className]}>
  <Image
    src={image}
    alt={alt}
    widths={[500, image.width]}
    sizes={sizes}
    class="w-full rounded-sm shadow-[0_4px_24px_rgba(0,0,0,0.25)]"
  />
  <Image
    src={tape1}
    alt=""
    aria-hidden="true"
    class="absolute -top-8 -left-8 h-auto w-32 -rotate-45 md:-top-12 md:-left-12 md:w-52"
  />
  <Image
    src={tape2}
    alt=""
    aria-hidden="true"
    class="absolute -top-8 -right-8 h-auto w-32 rotate-45 md:-top-12 md:-right-12 md:w-52"
  />
</div>
