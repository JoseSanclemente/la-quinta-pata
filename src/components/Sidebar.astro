---
// Create-a-circle panel. Slides in from the right; `.open` is toggled by
// src/scripts/sidebar.ts.
const COLORS = [
  "#e63946",
  "#f3722c",
  "#f9c74f",
  "#90be6d",
  "#43aa8b",
  "#577590",
  "#277da1",
  "#9b5de5",
  "#f15bb5",
  "#1d3557",
];

const fieldClass = "rounded-md border border-line p-2 font-normal text-navy";
const labelClass = "flex flex-col gap-1.5 font-semibold text-navy";
---

<!-- Floating button to open the creator -->
<button
  id="open-sidebar"
  title="Crear círculo"
  class="fixed bottom-4 left-1/2 z-20 -translate-x-1/2 cursor-pointer rounded-lg bg-navy px-4 py-2.5 text-[15px] font-semibold text-white shadow-[0_2px_10px_rgb(0_0_0/0.4)] hover:bg-navy-hover"
>
  + Crear
</button>

<aside
  id="sidebar"
  class="z-30 h-full w-80 max-w-[90vw] overflow-y-auto bg-paper p-5 shadow-[-4px_0_20px_rgb(0_0_0/0.4)]"
>
  <div class="flex items-center justify-between">
    <h2 class="m-0 text-2xl font-bold text-navy">Nuevo círculo</h2>
    <button
      id="close-sidebar"
      title="Cerrar"
      class="cursor-pointer border-none bg-transparent text-2xl leading-none text-navy"
    >
      ×
    </button>
  </div>

  <form id="circle-form" class="mt-4 flex flex-col gap-4">
    <!-- Live preview of the marker (color only for now; swap for "chais" later) -->
    <div class="mb-3 flex justify-center">
      <span
        id="circle-preview"
        class="size-14 rounded-full border-[3px] border-white/85 bg-brand shadow-[0_2px_8px_rgb(0_0_0/0.5)] transition-[background] duration-150"
      ></span>
    </div>

    <fieldset id="color-group" class="m-0 flex flex-wrap gap-2.5 border-none p-0">
      <legend class="mb-1.5 p-0 font-semibold text-navy">Color del círculo</legend>
      {
        COLORS.map((color, i) => (
          <label class="swatch size-7.5 cursor-pointer rounded-full" style={`--c: ${color}`}>
            <input type="radio" name="color" value={color} checked={i === 0} class="pointer-events-none absolute opacity-0" />
          </label>
        ))
      }
    </fieldset>

    <label class={labelClass}>
      Tipo de contenido
      <select id="media-type" class={fieldClass}>
        <option value="text">Texto</option>
        <option value="image">Imagen</option>
        <option value="video">Video</option>
      </select>
    </label>

    <!-- Text input (shown for "text") -->
    <label id="text-field" class={labelClass}>
      Texto
      <textarea id="text-content" rows="4" placeholder="Escribe algo..." class={fieldClass}
      ></textarea>
    </label>

    <!-- File input (shown for "image"/"video") -->
    <label id="file-field" class={`${labelClass} hidden`}>
      Archivo
      <input type="file" id="media-file" accept="image/*" class={fieldClass} />
    </label>

    <button
      type="submit"
      id="submit-circle"
      class="cursor-pointer rounded-lg border-none bg-brand p-3 text-[15px] font-bold text-white hover:bg-brand-hover disabled:cursor-not-allowed disabled:opacity-60"
    >
      Crear y soltar en el mapa
    </button>
    <p id="form-status" class="m-0 min-h-4.5 text-sm text-navy"></p>
  </form>
</aside>
