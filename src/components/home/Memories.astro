---
import { Image } from "astro:assets";
import MaskedShape from "@/components/MaskedShape.astro";
import PaperEdge from "@/components/PaperEdge.astro";
import TapedCard from "@/components/TapedCard.astro";
import star from "@/assets/blue_star.webp";

const photos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("@/assets/carousel/*.png", {
    eager: true,
  }),
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

const widths = [
  "w-[52vw] md:w-[30vw] lg:w-[19vw]",
  "w-[64vw] md:w-[36vw] lg:w-[24vw]",
  "w-[56vw] md:w-[32vw] lg:w-[21vw]",
  "w-[60vw] md:w-[34vw] lg:w-[22vw]",
];

const randomTilt = () => `${(Math.random() * 8 - 4).toFixed(2)}deg`;

const half = Math.ceil(photos.length / 2);
const topRow = photos.slice(0, half).map((image, i) => ({
  image,
  width: widths[i % widths.length],
  tilt: randomTilt(),
}));
const bottomRow = photos.slice(half).map((image, i) => ({
  image,
  width: widths[(i + 2) % widths.length],
  tilt: randomTilt(),
}));
---

<section class="bg-magenta relative overflow-hidden py-40 xl:py-60">
  <MaskedShape
    image={star}
    width={1400}
    class="star-spin bg-orange/60 absolute top-15 -left-30 w-full scale-150 md:scale-100 xl:w-2/3"
  />
  <MaskedShape
    image={star}
    width={1400}
    class="star-spin bg-orange/60 absolute bottom-50 left-1/3 w-full scale-200 md:scale-100 xl:w-2/3"
  />

  <div class="relative space-y-8 xl:space-y-30">
    <div class="page-grid">
      <h2
        class="text-section font-display md:text-section-lg col-start-1 col-end-5 text-center leading-tight font-extrabold text-white md:col-end-9 lg:col-span-12"
      >
        Recuerdos y anécdotas
      </h2>
    </div>

    <div class="group relative overflow-hidden">
      <div class="marquee-track animate-marquee flex w-max pt-8">
        {
          [false, true].map((clone) => (
            <div class="contents" aria-hidden={clone ? "true" : undefined}>
              {topRow.map((item, i) => (
                <TapedCard
                  index={i}
                  class:list={["mr-6 shrink-0 md:mr-8", item.width]}
                  style={`rotate: ${item.tilt}`}
                >
                  <Image
                    src={item.image}
                    alt=""
                    aria-hidden="true"
                    widths={[320, 640]}
                    sizes="(min-width: 1024px) 22vw, (min-width: 768px) 34vw, 60vw"
                    loading="eager"
                    class="aspect-4/5 w-full object-cover"
                  />
                </TapedCard>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="page-grid">
      <p
        class="col-start-1 col-end-5 text-center text-base leading-snug text-white md:col-start-2 md:col-end-8 md:text-base lg:col-start-4 lg:col-end-10 lg:text-2xl"
      >
        Memorias que cuentan algo sobre <strong class="font-extrabold italic"
          >quiénes somos</strong
        > y la forma en que <strong class="font-extrabold italic"
          >vivimos el mundo.</strong
        >
      </p>
    </div>

    <div class="group relative overflow-hidden">
      <div class="marquee-track animate-marquee-reverse flex w-max pt-8">
        {
          [false, true].map((clone) => (
            <div class="contents" aria-hidden={clone ? "true" : undefined}>
              {bottomRow.map((item, i) => (
                <TapedCard
                  index={i + 2}
                  class:list={["mr-6 shrink-0 md:mr-8", item.width]}
                  style={`rotate: ${item.tilt}`}
                >
                  <Image
                    src={item.image}
                    alt=""
                    aria-hidden="true"
                    widths={[320, 640]}
                    sizes="(min-width: 1024px) 22vw, (min-width: 768px) 34vw, 60vw"
                    loading="eager"
                    class="aspect-[4/5] w-full object-cover"
                  />
                </TapedCard>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
