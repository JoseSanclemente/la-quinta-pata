---
import { Image } from "astro:assets";
import MaskedShape from "@/components/MaskedShape.astro";
import PaperEdge from "@/components/PaperEdge.astro";
import TapedPhoto from "@/components/TapedPhoto.astro";
import star from "@/assets/blue_star.webp";
import chair from "@/assets/chair/yellow_chair.webp";
import chairPhoto from "@/assets/yellow_chair_photo.webp";
---

<section
  class="relative overflow-hidden bg-magenta pt-20 pb-32 md:pt-[10vw] md:pb-16 lg:pb-48"
>
  <PaperEdge class="top-0 bg-cream" />

  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <MaskedShape
      image={star}
      width={1000}
      class="absolute top-[4%] left-[2%] w-[70%] bg-blue/20 md:top-0 md:left-0 md:w-[44%]"
    />
  </div>

  <div class="page-grid relative z-10 gap-y-12 md:items-center">
    <div class="col-start-1 col-end-5 md:col-end-5 lg:col-end-6">
      <h2
        class="max-w-sm text-section leading-tight font-normal text-white md:text-section-lg"
      >
        La Rimax es de esas cosas que uno ve a diario y <em
          class="font-extrabold italic">ni le para bolas.</em
        >
      </h2>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-white md:text-base">
        Está en la terraza, en la tienda, en el cumpleaños, en el patio y hasta
        en el velorio cogiendo airecito.
      </p>

      <Image
        src={chair}
        alt="Silla Rimax amarilla"
        widths={[320, 640]}
        sizes="(min-width: 1024px) 320px, (min-width: 768px) 288px, 224px"
        class="mt-10 w-56 md:w-72 lg:w-80"
      />
    </div>

    <a
      href="/memorias"
      class="on-dark group col-start-1 col-end-5 rounded-sm md:col-start-5 md:col-end-9 lg:col-start-6 lg:col-end-13"
    >
      <TapedPhoto
        image={chairPhoto}
        alt="Un parrillero lleva una silla Rimax amarilla en moto, entre el tráfico"
        sizes="(min-width: 1024px) 52vw, (min-width: 768px) 58vw, 100vw"
        class="transition-transform duration-300 group-hover:-rotate-1"
      />
    </a>
  </div>
</section>
