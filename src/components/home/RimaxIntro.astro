---
import { Image } from "astro:assets";
import MaskedShape from "@/components/MaskedShape.astro";
import TapedPhoto from "@/components/TapedPhoto.astro";
import star from "@/assets/blue_star.webp";
import chair from "@/assets/chair/yellow_chair.webp";
import chairPhoto from "@/assets/yellow_chair_photo.webp";
import boxes from "@/assets/boxes.webp";
---

<section class="bg-magenta hatch-grid relative overflow-hidden pt-120 pb-60">
  <MaskedShape
    image={star}
    width={1000}
    class="star-spin bg-blue absolute bottom-50 left-50 w-1/2"
  />

  <div class="page-grid items-center">
    <div
      data-reveal
      class="z-10 col-start-1 col-end-6 row-start-1 flex flex-col items-center space-y-4"
    >
      <h2
        class="text-section md:text-section-lg max-w-sm leading-tight font-normal text-white md:max-w-xl"
      >
        La Rimax es de esas cosas que uno ve a diario y <em
          class="font-display italic">ni le para bolas.</em
        >
      </h2>
      <p
        class="max-w-sm text-base leading-relaxed text-white md:max-w-xl md:text-base lg:text-lg lg:leading-tight"
      >
        Está en la terraza, en la tienda, en el cumpleaños, en el patio y
        acompaña incluso los momentos de despedida.
      </p>

      <Image
        src={chair}
        alt="Silla Rimax amarilla"
        widths={[320, 640]}
        sizes="(min-width: 1024px) 320px, (min-width: 768px) 288px, 224px"
        class="chair-slide max-w-4/5 scale-x-[-1]"
      />
    </div>

    <Image
      src={boxes}
      alt=""
      class="z-20 col-start-3 col-end-7 row-start-1 translate-x-30 self-end"
    />

    <TapedPhoto
      image={chairPhoto}
      alt="Un parrillero lleva una silla Rimax amarilla en moto, entre el tráfico"
      sizes="(min-width: 1024px) 52vw, (min-width: 768px) 58vw, 100vw"
      class="col-start-1 col-end-5 transition-transform duration-300 group-hover:-rotate-1 md:col-end-9 lg:col-start-7 lg:col-end-13"
    />
  </div>
</section>
