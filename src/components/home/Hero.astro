---
import { Image } from "astro:assets";
import PaperEdge from "@/components/PaperEdge.astro";
import Button from "@/components/Button";
import heroLogo from "@/assets/Hero_logo.webp";
import heroBg from "@/assets/fondo_hero.webp";
---

<section id="hero" class="bg-neutral relative min-h-dvh">
  <div class="absolute inset-0 overflow-hidden">
    <Image
      src={heroBg}
      alt=""
      aria-hidden="true"
      widths={[768, 1440, 1920, heroBg.width]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <PaperEdge
      class="bg-magenta bottom-0 z-10 scale-y-100! lg:translate-y-12"
    />
  </div>

  <div class="relative z-10 flex min-h-dvh flex-col">
    <div class="page-grid relative flex-1 content-center gap-y-6 pb-5 md:pb-32">
      <Image
        src={heroLogo}
        alt="La Quinta Pata, archivo digital"
        widths={[480, 768, 1152, heroLogo.width]}
        sizes="(min-width: 1024px) 90vw, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="col-start-1 col-end-5 h-[36vh] w-auto max-w-full justify-self-center object-contain md:col-end-9 md:h-[48vh] lg:col-end-13 lg:row-start-1 lg:h-auto lg:max-h-[45vh] lg:max-w-full lg:self-center"
      />

      <nav
        aria-label="Principal"
        class="col-start-1 col-end-5 flex flex-col items-center justify-between gap-x-4 gap-y-4 md:hidden"
      >
        <Button href="/memorias" variant="primary" className="w-full">
          Dejá tu recuerdo
        </Button>
        <Button href="/quienes-somos" variant="link">¿Quiénes Somos?</Button>
      </nav>
    </div>
  </div>
</section>
