---
import { Image } from "astro:assets";
import Button from "@/components/Button";
import heroLogo from "@/assets/Hero_logo.webp";
import heroBg from "@/assets/fondo_hero.webp";
---

<section
  id="hero"
  class="bg-neutral relative min-h-lvh bg-cover bg-center bg-no-repeat"
  style={`background-image: url(${heroBg.src})`}
>
  <div class="relative z-10 flex">
    <div class="page-grid min-h-lvh gap-12">
      <Image
        src={heroLogo}
        alt="La Quinta Pata, archivo digital"
        widths={[480, 768, 1152, heroLogo.width]}
        sizes="(min-width: 1024px) 90vw, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="hero-logo col-span-full max-h-2/3 self-end object-contain md:self-center lg:max-h-2/5"
      />

      <nav
        aria-label="Principal"
        class="col-start-1 col-end-5 flex flex-col items-center justify-center space-y-4 self-center md:hidden"
      >
        <Button href="/memorias" variant="primary" className="w-full">
          Dejá tu recuerdo
        </Button>
        <Button href="/quienes-somos" variant="link">¿Quiénes Somos?</Button>
      </nav>
    </div>
  </div>
</section>
