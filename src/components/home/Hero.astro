---
import { Image } from "astro:assets";
import SiteHeader from "@/components/SiteHeader.astro";
import MaskedShape from "@/components/MaskedShape.astro";
import Button from "@/components/Button";
import hero from "@/assets/hero.webp";
import star from "@/assets/blue_star.webp";
---

<section class="bg-cream relative min-h-dvh overflow-hidden">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <MaskedShape
      image={star}
      width={1000}
      class="bg-magenta/25 absolute top-[6%] left-[-14%] w-[86%] lg:top-[2%] lg:left-[-10%] lg:w-[80%]"
    />
    <Image
      src={star}
      alt=""
      aria-hidden="true"
      widths={[400, 800, 1100]}
      sizes="(min-width: 1024px) 52vw, 76vw"
      class="absolute top-[10%] right-[-14%] w-[92%] opacity-45 lg:top-[4%] lg:right-[-8%] lg:w-full"
    />
  </div>

  <div class="relative z-10 flex min-h-dvh flex-col">
    <SiteHeader />

    <div class="page-grid relative flex-1 content-center gap-y-6 pb-5 md:pb-24">
      <div
        class="text-blue relative z-10 col-start-1 col-end-5 self-start lg:row-start-1 lg:mt-[14vh]"
      >
        <h1 class="text-hero leading-tight font-extrabold">
          ¡Quiubo, Hola, Hello!
        </h1>
        <p class="text-lead mt-4 leading-relaxed">
          Bienvenidx a La Quinta Pata. Pasá y conocé el primer archivo digital
          de la <strong class="font-bold">silla Rimax</strong>.
        </p>
      </div>

      <Image
        src={hero}
        alt="Mesa con sillas Rimax, sombrilla y radio bajo un letrero de 'Al aire'"
        widths={[480, 768, 1152, hero.width]}
        sizes="(min-width: 1024px) 85vw, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="col-start-1 col-end-5 h-[36vh] w-auto max-w-none justify-self-center object-contain md:col-end-9 md:h-[44vh] lg:col-end-13 lg:row-start-1 lg:h-auto lg:max-h-[80vh] lg:max-w-full lg:self-center"
      />

      <nav
        aria-label="Principal"
        class="col-start-1 col-end-5 flex flex-col items-center justify-between gap-x-4 gap-y-4 md:hidden"
      >
        <Button href="/memorias" variant="primary" className="w-full">
          Dejá tu recuerdo
        </Button>
        <Button href="/quienes-somos" variant="link">
          ¿Quiénes Somos?
        </Button>
      </nav>
    </div>
  </div>
</section>
