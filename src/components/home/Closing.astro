---
import { Image } from "astro:assets";
import wordmark from "@/assets/white_closing_logo.png";
import pinkChair from "@/assets/silla_rota.png";
import Button from "@/components/Button.tsx";
import Banner from "@/components/Banner.astro";
import closingBg from "@/assets/Closing_Section.png";
---

<section
  aria-label="La Quinta Pata"
  class="bg-blue hatch-grid relative"
  style={`--hatch-angle-a: 0deg; --hatch-angle-b: 90deg; --hatch-color: #ffffff26; --hatch-under: url(${closingBg.src}); background-size: auto, auto, cover; background-position: 0 0, 0 0, top; background-repeat: repeat, repeat, no-repeat;`}
>
  <div class="relative">
    <Banner class="text-blue -top-26 z-50 text-center">
      <div class="col-start-4 col-end-10">
        <p class="text-2xl">
          Porque aunque el tiempo nos deje tirados, <b
            >esos momentos siempre estarán con nosotros.
          </b>
        </p>
      </div>
    </Banner>

    <div class="page-grid items-center gap-y-12 pt-110 pb-20">
      <div class="col-start-5 col-end-9 space-y-12 text-center">
        <h2>
          <Image
            src={wordmark}
            alt="La Quinta Pata, archivo digital"
            widths={[480, 960, wordmark.width]}
            sizes="(min-width: 1024px) 48vw, (min-width: 768px) 58vw, 92vw"
            class="mx-auto mb-8 w-full"
          />
        </h2>
        <Image
          src={pinkChair}
          alt="Silla Rimax blanca rota"
          widths={[320, 640, pinkChair.width]}
          sizes="(min-width: 1024px) 32vw, (min-width: 768px) 34vw, 44vw"
          class="w-full object-contain"
        />

        <Button href="/memorias" variant="secondary">Deja tu recuerdo</Button>
      </div>
    </div>
  </div>
</section>
