---
import { Image } from "astro:assets";
import MaskedShape from "../MaskedShape.astro";
import purpleChair from "../../assets/purple_chair.webp";
import palmTree from "../../assets/palm_tree.webp";
import boxes from "../../assets/boxes.webp";
import tornEdgeBlue from "../../assets/torn_edge_2.webp";
import tornEdgeCream from "../../assets/torn_edge_4.webp";
import tornEdgeMagenta from "../../assets/torn_edge_3.webp";
---

<!-- Three paper bands stacked in flow: cream carries on from RimaxIntro's closing
     tear, then blue, then cream again. Each band pulls its OWN torn edge up above
     itself (bottom-full), so band heights stay content-driven and the section
     reflows instead of holding the mockup's fixed ratio.
     One z ladder: paper 0, collage 10, closing tear 20, copy 30. -->
<section class="relative overflow-hidden bg-cream">
  <!-- 1 — CREAM. No top tear: the previous section already ends in cream. -->
  <!-- Bottom padding has to clear the incoming tear's full depth (the strip is
       1/8 of the viewport width tall). The copy is text-blue on bg-blue, so an
       overlap doesn't just look tight — the words vanish. z-30 keeps the copy
       above the collage at every breakpoint. -->
  <div class="relative z-30 px-6 pt-10 pb-48 md:px-10 md:pt-14 md:pb-72">
    <div class="mx-auto grid max-w-7xl md:grid-cols-2 md:gap-12">
      <h2
        class="max-w-sm text-section leading-tight font-normal text-blue md:col-start-2 md:max-w-md md:text-section-lg"
      >
        Pero un día, nos dio por <em class="font-extrabold italic"
          >ponerle cuidado</em
        > a esa silla que ha estado ahí toda la vida.
      </h2>
    </div>
  </div>

  <!-- 2 — BLUE, the dominant field. The boxes are the only in-flow child, so they
       set the band's height; the chair is absolute and straddles the tear. -->
  <div
    class="relative min-h-[58vw] bg-blue px-6 pb-20 md:min-h-[26vw] md:px-10 md:pb-32"
  >
    <MaskedShape
      image={tornEdgeBlue}
      size="100% 100%"
      width={1600}
      class="absolute inset-x-0 bottom-full z-0 w-full translate-y-px bg-blue"
    />

    <div class="mx-auto max-w-7xl">
      <Image
        src={boxes}
        alt="Torre de canastas de leche de papel: crema y negra a la izquierda, rosada, amarilla y azul a la derecha"
        widths={[300, 600, boxes.width]}
        sizes="(min-width: 768px) 38vw, 56vw"
        class="relative z-10 -mt-20 ml-auto w-[56%] md:-mt-52 md:w-[38%] lg:mr-[8%]"
      />
    </div>

    <!-- top-0 + -translate-y-1/3: the offset is a share of the chair's OWN height,
         so it never depends on how tall the blue band ends up. -->
    <Image
      src={purpleChair}
      alt="Silla Rimax morada boca abajo, apoyada sobre dos piedras"
      widths={[260, 520, purpleChair.width]}
      sizes="(min-width: 768px) 30vw, 48vw"
      class="absolute top-0 left-0 z-10 w-[46%] -translate-y-[55%] md:left-[4%] md:w-[30%] md:-translate-y-[62%] lg:left-[8%]"
    />
  </div>

  <!-- 3 — CREAM again. Bottom padding is in vw because what it has to clear (the
       magenta closing tear) is itself a vw-sized strip. -->
  <div
    class="relative bg-cream px-6 pt-16 pb-[32vw] md:px-10 md:pt-24 md:pb-[22vw]"
  >
    <MaskedShape
      image={tornEdgeCream}
      size="100% 100%"
      width={1600}
      class="absolute inset-x-0 bottom-full z-0 w-full translate-y-px bg-cream"
    />

    <div class="mx-auto max-w-7xl">
      <p
        class="relative z-30 ml-auto w-[64%] text-center text-section leading-tight font-normal text-blue md:w-[45%] md:max-w-md md:text-section-lg"
      >
        Y encontramos algo que <em class="font-extrabold italic"
          >no pensábamos que hubiera...</em
        >
      </p>
    </div>
  </div>

  <!-- Palm: a child of the SECTION, not of a band, so it spans the blue and the
       cream at once. Bottom-anchored, so the trunks always land in the magenta
       tear no matter how the bands reflow. -->
  <Image
    src={palmTree}
    alt="Palma de plátano recortada en papel, con un racimo amarillo y una flor morada"
    widths={[400, 800, palmTree.width]}
    sizes="(min-width: 768px) 46vw, 50vw"
    class="pointer-events-none absolute bottom-0 left-[-18%] z-10 w-[50%] md:left-[-6%] md:w-[46%]"
  />

  <!-- Closing tear into the next section. Same shape as RimaxIntro's: masked strip
       plus a solid block carrying the fill to the section's bottom. z-20 puts it
       over the palm (trunks disappear behind it) but under the copy. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 z-20 flex flex-col justify-end"
  >
    <MaskedShape
      image={tornEdgeMagenta}
      size="100% 100%"
      width={1600}
      class="w-full shrink-0 bg-magenta"
    />
    <div class="h-16 w-full bg-magenta md:h-24"></div>
  </div>
</section>
