---
import { Image } from "astro:assets";
import MaskedShape from "@/components/MaskedShape.astro";
import purpleChair from "@/assets/purple_chair.webp";
import boxes from "@/assets/boxes.webp";
import palmTree from "@/assets/palm_tree.webp";
import tornEdgeCream from "@/assets/torn_edge_1.webp";
import tornEdgeWhite from "@/assets/torn_edge_4.webp";
---

<section
  class="relative grid h-[124vh] grid-cols-1 grid-rows-1 overflow-hidden bg-blue md:h-[112vh] [&>*]:col-start-1 [&>*]:row-start-1 [&>*]:h-full [&>*]:w-full"
>
  <div class="flex flex-col justify-between" aria-hidden="true">
    <div>
      <div class="h-[18vh] w-full bg-cream md:h-[20vh]"></div>
      <MaskedShape
        image={tornEdgeCream}
        size="100% 100%"
        width={1600}
        class="-mt-px w-full -scale-y-100 bg-cream"
      />
    </div>
    <div>
      <MaskedShape
        image={tornEdgeWhite}
        size="100% 100%"
        width={1600}
        class="w-full bg-white"
      />
      <div class="-mt-px h-[16vh] w-full bg-white md:h-[18vh]"></div>
    </div>
  </div>

  <div class="page-grid h-full items-start">
    <div class="relative col-start-1 col-end-3 row-start-1 h-full md:col-end-4 lg:col-end-5">
      <Image
        src={purpleChair}
        alt="Silla Rimax morada volteada patas arriba entre dos piedras"
        widths={[320, 640, purpleChair.width]}
        sizes="(min-width: 1024px) 32vw, (min-width: 768px) 34vw, 44vw"
        class="absolute top-[9%] left-0 max-h-[20%] w-full object-contain object-left-top md:top-[3%] md:max-h-[34%]"
      />
    </div>

    <div
      class="relative col-start-2 col-end-5 row-start-1 h-full md:col-start-5 md:col-end-9 lg:col-start-8 lg:col-end-13"
    >
      <p
        class="absolute top-[4%] right-0 text-sm leading-snug text-blue md:top-[6%] md:text-lead"
      >
        Pero un día, nos dio por <strong class="font-extrabold italic"
          >ponerle cuidado</strong
        > a esa silla que ha estado ahí toda la vida.
      </p>

      <Image
        src={boxes}
        alt="Canastas plásticas apiladas en crema, negro, magenta, amarillo y azul"
        widths={[400, 800, boxes.width]}
        sizes="(min-width: 1024px) 40vw, (min-width: 768px) 46vw, 58vw"
        class="absolute top-[26%] right-0 max-h-[26%] w-full object-contain object-right-top md:top-[20%] md:max-h-[44%]"
      />
    </div>

    <div
      class="relative col-start-1 col-end-4 row-start-1 h-full md:col-end-5 lg:col-end-6"
    >
      <Image
        src={palmTree}
        alt="Mata de plátano de papel con un racimo y su flor"
        widths={[400, 800, palmTree.width]}
        sizes="(min-width: 1024px) 40vw, (min-width: 768px) 46vw, 70vw"
        class="absolute bottom-[10%] left-0 max-h-[40%] w-full object-contain object-left-bottom md:bottom-[5%] md:max-h-[70%]"
      />
    </div>

    <div
      class="relative col-start-2 col-end-5 row-start-1 h-full md:col-start-5 md:col-end-9 lg:col-start-7 lg:col-end-12"
    >
      <p
        class="absolute right-0 bottom-[2%] text-sm leading-snug text-blue md:bottom-[16%] md:text-lead"
      >
        Y encontramos algo que <strong class="font-extrabold italic"
          >no pensábamos que hubiera…</strong
        >
      </p>
    </div>
  </div>
</section>
