---
import { Image } from "astro:assets";
import purpleChair from "@/assets/purple_chair.webp";
import boxes from "@/assets/boxes.webp";
import palmTree from "@/assets/Palma_Silla.png";
import PaperEdge from "@/components/PaperEdge.astro";
---

<section class="bg-blue relative flex min-h-[70vh]">
  <PaperEdge class="bg-blue -top-44 z-10" />
  <div class="page-grid items-center">
    <div class="relative col-span-5 space-y-8 text-center text-white">
      <p class="text-3xl">
        Pero un día, decidimos ir más lento y prestarle algo de atención.
      </p>
      <p class="font-display text-3xl">
        Y encontramos algo que no pensábamos que hubiera...
      </p>
    </div>

    <Image
      src={palmTree}
      alt=""
      class="absolute inset-x-1/2 -bottom-45 z-15 max-w-2/4"
    />
  </div>
  <PaperEdge class="bg-blue -bottom-32 z-10 scale-y-[-1]" />
</section>
