---
import { Image } from "astro:assets";
import palmTree from "@/assets/Palma_Silla.png";
import PaperEdge from "@/components/PaperEdge.astro";
---

<section
  class="bg-blue relative flex overflow-x-clip pt-10 lg:min-h-[70vh] lg:pt-0"
>
  <PaperEdge
    class="bg-blue top-[-5%] z-10 md:top-[-10%] lg:top-[-15%] xl:top-[-20%]"
  />
  <div class="page-grid items-center">
    <div
      class="relative col-span-4 space-y-8 text-center text-white lg:col-span-7"
    >
      <p class="text-3xl">
        Pero un día, decidimos ir más lento y prestarle algo de atención.
      </p>
      <p class="font-display text-3xl">
        Y encontramos algo que no pensábamos que hubiera...
      </p>
    </div>

    <Image
      src={palmTree}
      alt=""
      class="relative inset-x-1/5 bottom-[-6%] z-15 col-span-4 scale-125 lg:inset-x-0 lg:bottom-[-20%] lg:col-end-13 lg:scale-250 xl:bottom-0 2xl:scale-200"
    />
  </div>
  <PaperEdge
    class="bg-blue bottom-[-5%] z-10 scale-y-[-1] md:bottom-[-12.5%] lg:bottom-[-15%]"
  />
</section>
