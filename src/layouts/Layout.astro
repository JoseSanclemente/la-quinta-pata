---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "La Silla" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>{title}</title>
  </head>
  <body class="m-0">
    <slot />
  </body>
</html>
