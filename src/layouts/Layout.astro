---
import "../styles/global.css";

interface Props {
  title?: string;
  /** Fixed-viewport pages (the map) opt in; scrolling pages leave it off. */
  lockScroll?: boolean;
}

const { title = "La Silla", lockScroll = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>{title}</title>
  </head>
  <body class:list={["m-0", lockScroll && "lock-scroll"]}>
    <slot />
  </body>
</html>
