---
import Layout from "@/layouts/Layout.astro";
import MapViewport from "@/components/MapViewport.astro";
import Sidebar from "@/components/Sidebar.astro";
import { fetchCircles } from "@/lib/supabase.server";

export const prerender = false;

const circles = await fetchCircles();
---

<Layout lockScroll>
  <MapViewport />
  <Sidebar />

  <script id="circles-data" type="application/json" is:inline set:html={JSON.stringify(circles)} />

  <script>
    import "@/scripts/main";
  </script>
</Layout>
