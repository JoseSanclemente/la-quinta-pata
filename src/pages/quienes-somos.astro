---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import fotoNati from "@/assets/about_us/foto_nati.webp";
import fotoLina from "@/assets/about_us/foto_lina.webp";
import burbujaNati from "@/assets/about_us/burbuja_nati.webp";
import burbujaLina from "@/assets/about_us/burbuja_lina.webp";

export const prerender = true;

const bios = {
  nati: "Me encanta armar rompecabezas, coleccionar juegos de mesa, descubrir lugares ricos para comer y escuchar a Rawayana. Soy fan de Friends y disfruto encontrar la lógica detrás de las cosas, incluso cuando parecen un enredo.",
  lina: "Me gusta hacer collages, las totebags, comer empanadas y guardar recuerdos de cualquier plan, tengo la costumbre de coleccionar papelitos, entradas, fotos y cualquier objeto que me ayude a volver a ese momento.",
};
---

<Layout title="¿Quiénes Somos? | La Quinta Pata">
  <main
    id="contenido"
    class="bg-blue hatch-grid min-h-dvh pt-40 pb-20"
    style="--hatch-angle-a: 0deg; --hatch-angle-b: 90deg; --hatch-color: #ffffff26;"
  >
    <div class="page-grid space-y-12">
      <div
        class="bg-paper text-blue col-span-full flex flex-col gap-6 rounded-xl p-6"
      >
        <h1
          class="font-display mt-6 text-2xl leading-none font-normal md:text-3xl"
        >
          ¿Qué es La Quinta Pata?
        </h1>
        <p>
          La Quinta Pata es un archivo digital que recoge, conserva y comparte
          las historias que se han tejido alrededor de la silla Rimax en
          Colombia.
        </p>
        <p class="font-bold">Pero, ¿por qué La Quinta Pata?</p>
        <p>
          Porque buscamos encontrar eso que no siempre se ve a primera vista. La
          silla tiene cuatro patas, pero detrás de ella hay muchas más:
          historias, personas, lugares, encuentros, recuerdos y experiencias que
          también hacen parte de lo que somos; la pata perdida.
        </p>
        <p>
          La “quinta pata” es entonces esa otra mirada que proponemos:
          detenernos en un objeto cotidiano para descubrir todo lo que puede
          contar.
        </p>
        <p>
          Este archivo reúne fotografías, relatos, recuerdos, anécdotas y voces
          que normalmente no llegan a los archivos ni a los museos. Historias
          que viven en las casas, los barrios, las reuniones y en la memoria de
          quienes las han vivido.
        </p>
        <p>
          Somos un espacio para mirar lo cotidiano con otros ojos y construir,
          entre todos, un archivo de recuerdos alrededor de una silla que nos
          resulta familiar.
        </p>
      </div>

      <div
        class="col-span-full flex flex-col gap-20 md:gap-12 lg:flex-row lg:items-center lg:justify-center"
      >
        <div class="flex flex-col gap-2">
          <div
            class="relative col-span-full flex flex-col items-center md:col-start-1 md:col-end-6"
          >
            <Image
              src={burbujaNati}
              alt={bios.nati}
              widths={[320, 640]}
              sizes="260px"
              class="absolute -top-24 left-0 z-10 [display:none] w-48 md:-top-16 md:-left-40 md:w-64 lg:[display:block]"
            />
            <Image
              src={fotoNati}
              alt="Nati"
              widths={[320, 640]}
              sizes="(min-width: 768px) 280px, 240px"
              class="xl:w-full"
            />
          </div>
          <div>
            <p class="font-bold text-white">NATI</p>
            <p class="text-yellow">
              <span class="font-bold">Fundadora</span> - Diseñadora Gráfica
            </p>
            <p class="text-base text-white lg:[display:none]">
              {bios.nati}
            </p>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <div
            class="relative col-span-full flex flex-col items-center md:col-start-7 md:col-end-13"
          >
            <Image
              src={burbujaLina}
              alt={bios.lina}
              widths={[320, 640]}
              sizes="260px"
              class="absolute -top-24 right-0 z-10 [display:none] w-48 md:-top-16 md:-right-40 md:w-64 lg:[display:block]"
            />
            <Image
              src={fotoLina}
              alt="Lina"
              widths={[320, 640]}
              sizes="(min-width: 768px) 280px, 240px"
              class="xl:w-full"
            />
          </div>
          <div>
            <p class="font-bold text-white">LINA</p>
            <p class="text-yellow">
              <span class="font-bold">Fundadora</span> - Diseñadora Gráfica
            </p>
            <p class="text-base text-white lg:[display:none]">
              {bios.lina}
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
