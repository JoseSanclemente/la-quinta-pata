---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/home/Hero.astro";
import RimaxIntro from "@/components/home/RimaxIntro.astro";
import Discovery from "@/components/home/Discovery.astro";
import Memories from "@/components/home/Memories.astro";
import Closing from "@/components/home/Closing.astro";
import Banner from "@/components/Banner.astro";
import { Image } from "astro:assets";
import leftAssets from "@/assets/Assets_Left.png";
import rightAssets from "@/assets/Assets_Right.png";
import SiteFooter from "@/components/SiteFooter.astro";

export const prerender = true;
---

<Layout title="La Quinta Pata — Archivo digital de la silla Rimax">
  <main id="contenido">
    <Hero />

    <Banner
      class="text-blue top-[15%] text-center sm:top-[13.8%] md:top-[13.5%] lg:top-[12%] xl:top-[11.4%]"
    >
      <Image
        src={leftAssets}
        alt=""
        class="col-span-4 [display:none] lg:[display:block]"
      />
      <div class="col-span-4 md:col-start-3 md:col-end-7 lg:col-span-4">
        <h1 class="mb-1 text-2xl font-extrabold lg:mb-4 lg:text-5xl">
          ¡Quiubo, Hola, Hello!
        </h1>
        <p class="text-base lg:text-lg">
          Bienvenidx a La Quinta Pata. Pasá y conocé el primer archivo digital
          de la <b>silla Rimax.</b>
        </p>
      </div>
      <Image
        class="col-span-4 [display:none] lg:[display:block]"
        src={rightAssets}
        alt=""
      />
    </Banner>

    <RimaxIntro />

    <Discovery />

    <Memories />

    <Closing />

    <SiteFooter />
  </main>
</Layout>
