---
import Layout from "../layouts/Layout.astro";
import tornEdge from "../assets/torn_edge_3.webp";
import logo from "../assets/logo.webp";
import hero from "../assets/hero.webp";
import star from "../assets/blue_star.webp";
import chair from "../assets/chair/yellow_chair.webp";
import chairPhoto from "../assets/yellow_chair_photo.webp";
import tape1 from "../assets/tape_1.webp";
import tape2 from "../assets/tape_2.webp";
import tornEdgeCream from "../assets/torn_edge_1.webp";
---

<Layout>
  <main class="relative min-h-dvh overflow-hidden bg-cream">
    <div class="relative z-10 flex min-h-dvh flex-col">
      <header class="flex items-center justify-between gap-4 px-6 py-5 md:px-10">
        <a href="/">
          <img
            src={logo.src}
            alt="La Quinta Pata — Archivo digital"
            class="h-18 w-auto md:h-32"
          />
        </a>

        <nav class="flex items-center gap-4 md:gap-8">
          <a
            href="#quienes-somos"
            class="text-sm text-blue hover:underline md:text-base"
          >
            ¿Quiénes Somos?
          </a>
          <a
            href="/memorias"
            class="rounded-md bg-blue px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90 md:text-base"
          >
            Conocer anécdotas
          </a>
        </nav>
      </header>

      <!-- Copy sits over the artwork from md up; below that they stack. -->
      <div
        class="relative flex flex-1 flex-col items-center justify-center gap-8 px-6 pb-28 md:px-10"
      >
        <!-- Torn-paper stars behind the artwork. The pink one is the same asset
             used as an alpha mask over a flat pink fill, so both come from
             blue_star.webp. Purely decorative, so they never take pointer events. -->
        <div class="pointer-events-none absolute inset-0">
          <div
            class="absolute top-[2%] left-[14%] w-[50%] bg-magenta/25"
            style={`aspect-ratio: ${star.width} / ${star.height};
                    -webkit-mask: url(${star.src}) center / contain no-repeat;
                    mask: url(${star.src}) center / contain no-repeat;`}
          >
          </div>
          <img
            src={star.src}
            alt=""
            aria-hidden="true"
            class="absolute top-[10%] right-[18%] w-[52%] opacity-45"
          />
        </div>

        <div
          class="relative max-w-md text-blue md:absolute md:top-1/2 md:left-10 md:w-96 md:-translate-y-1/2 lg:w-md"
        >
          <h1 class="text-[40px] leading-tight font-extrabold">
            ¡Quiubo, Hola, Hello!
          </h1>
          <p class="mt-4 text-[20px] leading-relaxed">
            Bienvenidx a La Quinta Pata. Pasá y conocé el primero archivo
            digital de la <strong class="font-bold">silla Rimax</strong>.
          </p>
        </div>

        <img
          src={hero.src}
          alt="Mesa con sillas Rimax, sombrilla y radio bajo un letrero de 'Al aire'"
          class="relative w-full max-w-6xl object-contain md:max-h-[92vh] md:w-auto"
        />
      </div>
    </div>

    <!-- Torn paper edge closing off the hero. The asset is a white-on-transparent
         strip, so it's used as an alpha mask over a magenta fill instead of as
         an <img>; the aspect ratio keeps the strip's proportions at any width. -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 -bottom-10 z-20 w-full bg-magenta"
      style={`aspect-ratio: ${tornEdge.width} / ${tornEdge.height};
              -webkit-mask: url(${tornEdge.src}) center / 100% 100% no-repeat;
              mask: url(${tornEdge.src}) center / 100% 100% no-repeat;`}
    >
    </div>
  </main>

  <!-- Picks up where the hero's torn edge leaves off — same magenta, so the tear
       reads as this section's top edge. -->
  <section class="relative overflow-hidden bg-magenta px-6 pt-20 pb-20 md:px-10 md:pb-16">
    <!-- Starburst sitting behind the chair. Same alpha-mask trick as the hero:
         blue at 30% over the magenta lands on the violet the artwork uses, so no
         extra palette token is needed. -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute top-[4%] left-[2%] w-[70%] bg-blue/20 md:top-0 md:left-0 md:w-[44%]"
        style={`aspect-ratio: ${star.width} / ${star.height};
                -webkit-mask: url(${star.src}) center / contain no-repeat;
                mask: url(${star.src}) center / contain no-repeat;`}
      >
      </div>
    </div>

    <div
      class="relative z-10 mx-auto grid max-w-7xl gap-12 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] md:items-center md:gap-12"
    >
      <div>
        <h2
          class="max-w-sm text-[28px] leading-tight font-normal text-white md:text-[34px]"
        >
          La Rimax es de esas cosas que uno ve a diario y <em
            class="font-extrabold italic">ni le para bolas.</em
          >
        </h2>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white md:text-base">
          Está en la terraza, en la tienda, en el cumpleaños, en el patio y hasta
          en el velorio cogiendo airecito.
        </p>

        <img
          src={chair.src}
          alt="Silla Rimax amarilla"
          class="mt-10 w-56 md:w-72 lg:w-80"
        />
      </div>

      <!-- Photo is taped down: the strips overhang the corners, so they're
           positioned against this wrapper rather than the image itself. -->
      <div class="relative">
        <img
          src={chairPhoto.src}
          alt="Un parrillero lleva una silla Rimax amarilla en moto, entre el tráfico"
          class="w-full rounded-sm shadow-[0_4px_24px_rgba(0,0,0,0.25)]"
        />
        <img
          src={tape1.src}
          alt=""
          aria-hidden="true"
          class="absolute -top-7 -left-6 h-24 w-auto -rotate-45 md:-top-10 md:-left-10 md:h-40"
        />
        <img
          src={tape2.src}
          alt=""
          aria-hidden="true"
          class="absolute -top-8 -right-6 h-28 w-auto rotate-45 md:-top-12 md:-right-10 md:h-44"
        />
      </div>
    </div>

    <!-- Cream tear closing the section — different silhouette from the hero's
         edge so the two don't read as the same cut. It sits BEHIND the collage
         (z-0) and rides high, so the chair and the photo overhang it. The masked
         strip is torn along its top and solid below, so a plain cream block
         carries the fill the rest of the way to the section's bottom. -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 z-0 flex flex-col justify-end"
    >
      <div
        class="w-full shrink-0 bg-cream"
        style={`aspect-ratio: ${tornEdgeCream.width} / ${tornEdgeCream.height};
                -webkit-mask: url(${tornEdgeCream.src}) center / 100% 100% no-repeat;
                mask: url(${tornEdgeCream.src}) center / 100% 100% no-repeat;`}
      >
      </div>
      <div class="h-14 w-full bg-cream md:h-20"></div>
    </div>
  </section>
</Layout>
