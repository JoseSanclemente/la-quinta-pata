# 1. Copy this file to `.env` (gitignored).
# 2. Fill in from Supabase dashboard -> Project Settings -> API.

# Sent to the browser. Public by design: the RLS policies are the security boundary.
PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="YOUR-PUBLISHABLE-KEY"

# Optional, server only. Never exposed to the browser.
# Leave empty to make the SSR read use PUBLIC_SUPABASE_ANON_KEY instead.
SUPABASE_SERVICE_KEY=""
