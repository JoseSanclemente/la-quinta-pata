# The @astrojs/netlify adapter recreates the function's node_modules by symlinking
# into pnpm's .pnpm store. On Windows that needs Developer Mode or admin rights,
# so `pnpm build` dies with "EPERM: operation not permitted, symlink".
# A hoisted (flat, npm-shaped) node_modules sidesteps it and still de-duplicates
# via pnpm's content-addressable store.
node-linker=hoisted
